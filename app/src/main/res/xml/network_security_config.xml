<?xml version="1.0" encoding="utf-8"?>
<!--
  The Hermes gateway is plain HTTP on 167.233.226.174:8642 (bearer-key
  gated, not TLS; see HermesApi.kt for the security tradeoff notes).
  Cleartext is scoped to exactly that host; every other host keeps
  Android's default modern policy (cleartext blocked).

  NOTE: the gateway URL is user-editable in Settings. A custom http:// URL
  pointing at any OTHER host will be blocked by this policy until that
  host is allowlisted here too. HTTPS URLs always work.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">167.233.226.174</domain>
    </domain-config>
</network-security-config>
