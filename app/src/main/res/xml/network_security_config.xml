<?xml version="1.0" encoding="utf-8"?>
<!--
  Wendy's mobile API is plain HTTP on 74.208.155.72:8090 (bearer-token
  gated, not TLS; see WendyApi.kt for the security tradeoff notes), and
  the Hermes gateway is the same tradeoff on 167.233.226.174:8642 (see
  HermesApi.kt). Cleartext is scoped to exactly these two hosts; every
  other host keeps Android's default modern policy (cleartext blocked).

  NOTE: the Hermes gateway URL is user-editable in Settings. A custom
  http:// URL pointing at any OTHER host will be blocked by this policy
  until that host is allowlisted here too. HTTPS URLs always work.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">74.208.155.72</domain>
        <domain includeSubdomains="false">167.233.226.174</domain>
    </domain-config>
</network-security-config>
